# Kontakt forma → Gmail (src/app/api/contact/route.ts)
# Kopiraj u .env.local (lokalno) i unesi iste vrednosti kod hosting provajdera.

# Gmail nalog preko kog se šalju upiti
GMAIL_USER=investbuducnost@gmail.com
# Lozinka za aplikacije: myaccount.google.com/apppasswords
# (nalog mora imati uključenu verifikaciju u dva koraka)
GMAIL_APP_PASSWORD=
# Opciono — primalac upita; podrazumevano investbuducnost@gmail.com
CONTACT_TO_EMAIL=
